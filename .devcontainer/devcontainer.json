{
  "name": "Python Simulation Dev",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "mounts": [

    "source=/Users/mayadagher/Documents/Locusts/hangar/outputs/,target=/output,type=bind",
    "source=/Users/mayadagher/Documents/Locusts/hangar/tracking/bb/,target=/bb,type=bind,readonly",
    "source=/Users/mayadagher/Documents/Locusts/hangar/tracking/keypoints/,target=/keypoints,type=bind",
    "source=/Users/mayadagher/Documents/Locusts/hangar/tracking/mocap/,target=/mocap,type=bind",
    "source=/Users/mayadagher/Documents/Locusts/hangar/original/,target=/original,type=bind",
    "source=/Users/mayadagher/Documents/Locusts/hangar/intrinsic_calibration/,target=/intrinsics,type=bind"
  ],
  "containerEnv": {
    "PYTHONPATH": "/calibration_src:/workspaces/project/src"
  },
  
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
